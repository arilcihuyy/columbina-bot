# ─────────────────────────────────────────────────────────────────────────────
#  Konfigurasi bot — copy file ini jadi `.env` lalu isi.
#  Cara termudah: `npm run setup` (wizard akan menulis .env untuk kamu).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Identitas bot ───────────────────────────────────────────────────────────
BOT_NAME=Columbina Bot
# Prefix command. Satu karakter = prefix tunggal ("!").
# Boleh beberapa: "!." → ! dan .   |   "!,/" → ! dan /   |   "!!,." (multi-karakter, pisah koma)
PREFIX=!

# Nomor pemilik (format 62xxx tanpa +). Dipakai untuk proteksi command:
# kalau diisi, hanya nomor ini yang bisa memakai command bot.
# Kosongkan = siapa pun yang tahu nomor bot bisa memakainya (tidak disarankan).
OWNER_NUMBER=

# ─── Login WhatsApp ──────────────────────────────────────────────────────────
# Isi nomor HP kamu (format 62xxx tanpa +) → bot menampilkan KODE PAIRING.
# Kosongkan → bot menampilkan QR di terminal.
PAIRING_NUMBER=

# Logging: silent | error | warn | info | debug | trace
LOG_LEVEL=info
# Balas pesan yang dikirim dari nomor bot sendiri? true/false
RESPOND_TO_SELF=false
# Folder penyimpanan sesi login (JANGAN di-commit ke git!)
SESSION_PATH=./sessions

# ─── Menu (!menu) ────────────────────────────────────────────────────────────
#   image = kirim gambar banner dulu (default) | text = banner ASCII | off = teks saja
MENU_BANNER=image
# Gambar banner (default ./assets/columbina/banner.jpg — ganti sesuai selera)
# MENU_BANNER_IMAGE_FILE=./assets/columbina/banner.jpg
# Gambar ASCII banner (dipakai kalau MENU_BANNER=text)
# MENU_BANNER_FILE=./assets/menu-banner.txt
# math = judul/kategori bold-italic unicode (default) | plain = huruf biasa
MENU_STYLE=math
# on = tampilkan daftar alias di menu | off = menu bersih (default)
MENU_ALIAS=off
# Teks di baris paling bawah menu (default: kata pertama BOT_NAME, lowercase)
# MENU_FOOTER=columbina

# ─── YouTube (opsional, tapi sering WAJIB di VPS) ────────────────────────────
# IP datacenter biasanya diblokir YouTube ("Sign in to confirm you're not a bot").
# Solusi: export cookies browser yang sudah login YouTube ke file, lalu isi path-nya.
# Cara: pasang ekstensi Chrome "Get cookies.txt LOCALLY" → export → taruh di server.
# YT_COOKIES_PATH=./cookies/youtube.txt
# Path biner yt-dlp kalau tidak ada di PATH
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Lewatkan lewat proxy (opsional), mis. socks5://127.0.0.1:9050
# YT_PROXY=
# Argumen tambahan yt-dlp (opsional)
# YT_EXTRACTOR_ARGS=
# YT_EXTRA_ARGS=

# ─── Instagram (opsional) ────────────────────────────────────────────────────
# Instagram sering menutup akses anonim dari IP server (post publik dianggap
# "private/dihapus"). Isi cookie session browser yang sudah login IG.
# Cara ambil: DevTools (F12) > Network > klik request ke instagram.com >
# copy header "cookie:" (string panjang) > paste di sini.
# IG_COOKIE=sessionid=...; mid=...; ig_did=...

# ─── Hapus background: !rmbg (lokal, gratis) ─────────────────────────────────
# Butuh venv Python dengan rembg:
#   python3 -m venv ~/rembg-venv && ~/rembg-venv/bin/pip install rembg onnxruntime
# Path python venv (default: ~/rembg-venv/bin/python)
# RMBG_PYTHON=/home/kamu/rembg-venv/bin/python
# Model rembg — u2netp = ringan (RAM kecil) | u2net = lebih bagus tapi berat
# RMBG_MODEL=u2netp

# ─── Hapus background: !arbg (Adobe Express, kualitas tinggi) ────────────────
# Butuh login Adobe sekali di profil Chrome (lihat README bagian "Fitur opsional").
# Timeout maksimum per request (ms)
# ADOBE_TIMEOUT_MS=300000

# ─── !cek (lihat tujuan asli link / anti-shortlink) ──────────────────────────
# Lewat Tor supaya tidak mudah diblokir Cloudflare (default 127.0.0.1:9050).
# Kosongkan untuk koneksi langsung. Butuh `tor` terpasang kalau dipakai.
# LINKCHECK_TOR=127.0.0.1:9050
# LINKCHECK_TIMEOUT=40
# LINKCHECK_MAX_HOPS=8
# LINKCHECK_UA=

# ─── Stiker teks / brat (opsional, jarang perlu diubah) ──────────────────────
# Folder font sendiri (default ./assets/fonts)
# BRAT_FONT_DIR=./assets/fonts
# Urutan font yang dipakai (koma, font pertama yang tersedia menang)
# BRAT_FONT=Arial, Archivo Narrow, Arial Narrow, Liberation Sans Narrow, sans-serif
# BRAT_BG=#ffffff
# BRAT_FG=#000000
# Huruf besar? (default lower = kecil semua, khas gaya brat)
# BRAT_CASE=lower
# Batas panjang teks stiker
# TEXTSTICKER_MAX_LEN=200

# ─── Debug (biarkan kosong kalau tidak sedang dipakai) ───────────────────────
# PRW_DOCTOR=1                 # diagnosa pengiriman pesan sekali-lihat
# STICKER_SELFTEST=1           # kirim stiker uji ke nomor sendiri
# BOT_TEMP_DIR=/home/kamu/wa-tmp   # folder kerja (jangan di /tmp!)